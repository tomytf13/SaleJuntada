PORT=3001
FRONTEND_URL=http://localhost:5173
# En producción acepta una lista separada por comas.
FRONTEND_URLS=
ENABLE_SWAGGER=true

# Supabase Auth. El backend verifica el JWT con la clave publishable; nunca uses
# SUPABASE_SECRET_KEY ni service_role en el frontend.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Desarrollo local creado por `npm run db:local:start`:
# DATABASE_URL=postgresql://salejuntada:salejuntada_dev@127.0.0.1:54329/sale_juntada_dev?schema=public
# DIRECT_URL=postgresql://salejuntada:salejuntada_dev@127.0.0.1:54329/sale_juntada_dev?schema=public

# Supabase transaction pooler (:6543). Uso normal de NestJS/Prisma en despliegues serverless.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase session pooler (:5432). Prisma Migrate y redes sin IPv6.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
