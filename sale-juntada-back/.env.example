PORT=3001
FRONTEND_URL=http://localhost:5173
# En producción acepta una lista separada por comas.
FRONTEND_URLS=
ENABLE_SWAGGER=true

# Debe ser el mismo OAuth 2.0 Web Client ID usado por el frontend.
GOOGLE_CLIENT_ID=

# Neon pooled connection. Uso normal de NestJS/Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Neon direct connection. Prisma Migrate.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ENDPOINT.sa-east-1.aws.neon.tech/neondb?sslmode=require
