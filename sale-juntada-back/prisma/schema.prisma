generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GatheringStatus {
  /// Todavía no tiene fecha: el grupo la está buscando con la encuesta de
  /// disponibilidad. En este estado el RSVP no aplica.
  OPEN
  /// Tiene fecha confirmada (`finalizedStart`). Recién acá existe el RSVP.
  CONFIRMED
  CANCELLED
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum AvailabilityKind {
  AVAILABLE
  MAYBE
  UNAVAILABLE
}

enum PurchaseCategory {
  FOOD
  DRINKS
  OTHER
  ALCOHOL
}

model Gathering {
  id                    String                 @id @default(cuid())
  slug                  String                 @unique
  title                 String
  description           String?
  locationHint          String?
  locationLatitude      Float?
  locationLongitude     Float?
  organizerName         String
  timeZone              String                 @default("America/Argentina/Buenos_Aires")
  windowStart           DateTime
  windowEnd             DateTime
  durationMinutes       Int                    @default(180)
  dailyStartMinutes     Int                    @default(780)
  dailyEndMinutes       Int                    @default(1440)
  slotStepMinutes       Int                    @default(480)
  status                GatheringStatus        @default(OPEN)
  finalizedStart        DateTime?
  finalizedEnd          DateTime?
  finalizedLocation     String?
  expenseRound          Int                    @default(1)
  participants          Participant[]
  expenses              Expense[]
  transferConfirmations TransferConfirmation[]
  purchasePlan          PurchasePlan?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([status, windowStart])
}

model Participant {
  id                    String                 @id @default(cuid())
  gatheringId           String
  gathering             Gathering              @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  name                  String
  contact               String?
  avatarUrl             String?
  authUserId            String?
  dietaryPreferences    String[]               @default([])
  mealArrangement       String?
  paymentAlias          String?
  isOrganizer           Boolean                @default(false)
  /// Credencial bearer del participante. La genera la aplicación con
  /// `generateParticipantToken()` (32 bytes de node:crypto). Sin `@default`
  /// a propósito: `cuid()` no es criptográficamente aleatorio y este campo
  /// autoriza gastos, transferencias y el cierre de la juntada.
  responseToken         String                 @unique
  /// Respuesta a la invitación. `null` significa una de dos cosas y el
  /// `finalizedStart` de la juntada alcanza para distinguirlas: si la
  /// juntada no tiene fecha, el RSVP no aplica; si la tiene, esta persona
  /// todavía no respondió.
  rsvpStatus            RsvpStatus?
  /// Acompañantes que trae quien respondió GOING. No crean participantes:
  /// son un número en la fila de quien los trae. Cuentan para la asistencia;
  /// qué hacen con la división de gastos lo decide P3.
  plusOnes              Int                    @default(0)
  rsvpAt                DateTime?
  expensesReadyAt       DateTime?
  availabilities        Availability[]
  expensesPaid          Expense[]
  transfersSent         TransferConfirmation[] @relation("TransferFrom")
  transfersReceived     TransferConfirmation[] @relation("TransferTo")
  purchasePlansUpdated  PurchasePlan[]         @relation("PurchasePlanUpdatedBy")
  purchaseItemsAssigned PurchaseItem[]         @relation("PurchaseItemAssignee")
  purchaseContributions PurchaseContribution[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([gatheringId, authUserId])
  @@index([gatheringId])
  @@index([authUserId])
  /// Sirve al agrupado por estado que arma el resumen de asistencia.
  @@index([gatheringId, rsvpStatus])
}

model UserPaymentProfile {
  authUserId   String   @id
  paymentAlias String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Availability {
  id            String           @id @default(cuid())
  participantId String
  participant   Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  endsAt        DateTime
  kind          AvailabilityKind @default(AVAILABLE)
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([participantId, startsAt, endsAt])
  @@index([startsAt, endsAt])
}

model Expense {
  id                  String      @id @default(cuid())
  gatheringId         String
  gathering           Gathering   @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  paidByParticipantId String
  paidBy              Participant @relation(fields: [paidByParticipantId], references: [id], onDelete: Cascade)
  description         String
  amountCents         Int
  /// Clave que envía el cliente en `Idempotency-Key`. Es obligatoria: un
  /// reintento de red no debe poder duplicar un gasto, y una columna
  /// opcional dejaría abierto el camino de "me olvidé de mandarla".
  /// El único acceso concurrente seguro es el índice único de abajo.
  idempotencyKey      String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([gatheringId, idempotencyKey])
  @@index([gatheringId, createdAt])
  @@index([paidByParticipantId])
}

model TransferConfirmation {
  id                String      @id @default(cuid())
  gatheringId       String
  gathering         Gathering   @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  fromParticipantId String
  fromParticipant   Participant @relation("TransferFrom", fields: [fromParticipantId], references: [id], onDelete: Cascade)
  toParticipantId   String
  toParticipant     Participant @relation("TransferTo", fields: [toParticipantId], references: [id], onDelete: Cascade)
  amountCents       Int
  expenseRound      Int         @default(1)
  confirmedAt       DateTime    @default(now())

  @@unique([gatheringId, expenseRound, fromParticipantId, toParticipantId], name: "roundPair", map: "TransferConfirmation_round_pair_key")
  @@index([gatheringId])
  @@index([fromParticipantId])
  @@index([toParticipantId])
}

model PurchasePlan {
  id                     String         @id @default(cuid())
  gatheringId            String         @unique
  gathering              Gathering      @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  includeAlcohol         Boolean        @default(false)
  ageConfirmed           Boolean        @default(false)
  participantBaseline    Int            @default(1)
  updatedByParticipantId String?
  updatedBy              Participant?   @relation("PurchasePlanUpdatedBy", fields: [updatedByParticipantId], references: [id], onDelete: SetNull)
  items                  PurchaseItem[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([updatedByParticipantId])
}

model PurchaseItem {
  id                    String                 @id @default(cuid())
  purchasePlanId        String
  purchasePlan          PurchasePlan           @relation(fields: [purchasePlanId], references: [id], onDelete: Cascade)
  key                   String
  label                 String
  unit                  String
  quantity              Int
  category              PurchaseCategory
  position              Int                    @default(0)
  assignedParticipantId String?
  assignee              Participant?           @relation("PurchaseItemAssignee", fields: [assignedParticipantId], references: [id], onDelete: SetNull)
  assignedAt            DateTime?
  isReady               Boolean                @default(false)
  contributions         PurchaseContribution[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([purchasePlanId, key])
  @@index([purchasePlanId, position])
  @@index([assignedParticipantId])
}

model PurchaseContribution {
  id                    String               @id @default(cuid())
  purchaseItemId        String
  purchaseItem          PurchaseItem         @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)
  participantId         String
  participant           Participant          @relation(fields: [participantId], references: [id], onDelete: Cascade)
  catalogProductId      String?
  catalogProduct        CatalogProduct?      @relation(fields: [catalogProductId], references: [id], onDelete: SetNull)
  catalogPresentationId String?
  catalogPresentation   CatalogPresentation? @relation(fields: [catalogPresentationId], references: [id], onDelete: SetNull)
  description           String
  quantity              Int                  @default(1)
  unit                  String               @default("unidad")
  note                  String?
  isReady               Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([purchaseItemId, participantId])
  @@index([purchaseItemId, updatedAt])
  @@index([participantId])
  @@index([catalogProductId])
  @@index([catalogPresentationId])
}

model CatalogProduct {
  id            String                 @id @default(cuid())
  key           String                 @unique
  categoryKey   String
  name          String
  brand         String?
  description   String?
  visualKey     String
  accentColor   String                 @default("#ff6b35")
  tags          String[]               @default([])
  isAlcohol     Boolean                @default(false)
  isActive      Boolean                @default(true)
  position      Int                    @default(0)
  presentations CatalogPresentation[]
  contributions PurchaseContribution[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([categoryKey, isActive, position])
}

model CatalogPresentation {
  id            String                 @id @default(cuid())
  productId     String
  product       CatalogProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  key           String
  label         String
  unit          String
  position      Int                    @default(0)
  isActive      Boolean                @default(true)
  contributions PurchaseContribution[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([productId, key])
  @@index([productId, isActive, position])
}
