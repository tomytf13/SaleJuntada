VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001
# Supabase Auth. Esta clave publishable es pública y segura para el navegador.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Tiles del mapa. Obligatorio en producción: la Tile Usage Policy de
# OpenStreetMap no permite usar tile.openstreetmap.org desde una aplicación.
# Proveedores con plan gratuito: MapTiler, Protomaps, Stadia Maps.
VITE_MAP_TILES_URL=
VITE_MAP_TILES_ATTRIBUTION=
